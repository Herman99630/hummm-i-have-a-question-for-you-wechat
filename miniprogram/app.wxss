page {
  min-height: 100%;
  background: linear-gradient(145deg, #fff9f7 0%, #ffe9ec 55%, #f8e9ff 100%);
  color: #571b2d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after { border: 0; }

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 28rpx 64rpx;
}

.card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  padding: 48rpx 38rpx;
  border: 2rpx solid rgba(145, 51, 78, 0.12);
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 28rpx 80rpx rgba(119, 34, 61, 0.13);
}

.language-toggle {
  position: absolute;
  z-index: 10;
  top: 24rpx;
  right: 24rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 241, 242, 0.9);
  color: #8c6070;
  font-size: 23rpx;
  line-height: 1;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff0f1;
  color: #a52c50;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.title {
  margin: 28rpx 0 18rpx;
  color: #4e1427;
  font-family: "STKaiti", "KaiTi", "PingFang SC", serif;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle {
  margin: 0;
  color: #8b6572;
  font-size: 28rpx;
  line-height: 1.75;
}

.primary-button {
  width: 100%;
  height: 94rpx;
  margin-top: 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #c62958, #8f1740);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 94rpx;
  box-shadow: 0 18rpx 34rpx rgba(166, 27, 71, 0.24);
}

.primary-button[disabled] { opacity: 0.45; }

.secondary-button {
  width: 100%;
  height: 86rpx;
  margin-top: 20rpx;
  border: 2rpx solid #efd4dc;
  border-radius: 999rpx;
  background: #fff;
  color: #8f1740;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.text-button {
  margin-top: 24rpx;
  background: transparent;
  color: #9b6d7b;
  font-size: 25rpx;
  line-height: 1.5;
}

.field { display: block; margin-top: 28rpx; }
.field-label { display: block; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 700; }
.field-input, .field-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid #efd7dd;
  border-radius: 24rpx;
  background: #fffaf9;
  color: #54172a;
  font-size: 28rpx;
}
.field-input { height: 92rpx; padding: 0 26rpx; }
.field-textarea { height: 170rpx; padding: 24rpx 26rpx; }
.counter { display: block; margin-top: 8rpx; color: #aa8993; font-size: 22rpx; text-align: right; }

.choice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 30rpx; }
.choice {
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 22rpx;
  border: 2rpx solid #efd9df;
  border-radius: 26rpx;
  background: #fffafa;
  color: #5c2637;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.35;
}
.choice.selected { border-color: #bd3159; background: #fff0f3; color: #94163d; box-shadow: 0 10rpx 24rpx rgba(158, 32, 72, 0.11); }
.choice-emoji { display: block; margin-bottom: 8rpx; font-size: 38rpx; }

.progress { display: flex; gap: 10rpx; margin: 14rpx 110rpx 40rpx 0; }
.progress-dot { flex: 1; height: 8rpx; border-radius: 999rpx; background: #f1dce2; }
.progress-dot.active { background: #b72250; }

.back { display: inline-block; margin: 0 0 22rpx; color: #9a6475; font-size: 25rpx; }
.step-kicker { color: #b22b53; font-size: 23rpx; font-weight: 800; letter-spacing: 2rpx; }
.hint { margin-top: 18rpx; color: #9d7481; font-size: 24rpx; line-height: 1.6; }
.error { margin-top: 20rpx; color: #b91c45; font-size: 24rpx; text-align: center; }
.empty { padding: 80rpx 0 40rpx; color: #a27a86; text-align: center; }
.heart-mark { color: #cf315f; }

.summary { margin-top: 30rpx; padding: 8rpx 28rpx; border-radius: 28rpx; background: #fff5f5; }
.summary-row { padding: 24rpx 0; border-bottom: 2rpx solid #f1dde2; }
.summary-row:last-child { border-bottom: 0; }
.summary-label { display: block; margin-bottom: 8rpx; color: #a57784; font-size: 22rpx; }
.summary-value { color: #54172a; font-size: 27rpx; font-weight: 750; line-height: 1.55; }

.made-with { margin-top: 28rpx; color: rgba(93, 39, 56, 0.48); font-size: 22rpx; text-align: center; }

<view class="page-shell">
  <view class="card creator-card">
    <button class="language-toggle" bindtap="toggleLanguage">中 / EN</button>

    <block wx:if="{{stage === 'cover'}}">
      <view class="cover-copy">
        <view class="eyebrow">✦ {{t.eyebrow}}</view>
        <view wx:if="{{language === 'zh'}}" class="title cover-title"><text>你负责心动</text><text class="title-accent">我负责开口</text></view>
        <view wx:else class="title cover-title">{{t.title}}</view>
        <view wx:if="{{language === 'zh'}}" class="cover-bridge"><text>有点紧张，但还是想约你</text><text>没关系，我陪你</text></view>
        <view wx:else class="cover-bridge">{{t.bridge}}</view>
        <view class="subtitle cover-body">{{t.body}}</view>
        <button class="primary-button" bindtap="begin"><text>{{t.start}}</text><text class="button-icon">♥</text></button>
        <view class="safe-note">✓ {{t.noAccount}}</view>
      </view>
      <image class="cover-image" src="/images/love-bear.png" mode="aspectFit" />
      <view class="steps">
        <view><text>①</text><text>{{language === 'zh' ? '写下心意' : 'Write it'}}</text></view>
        <view><text>②</text><text>{{language === 'zh' ? '发给 TA' : 'Share it'}}</text></view>
        <view><text>③</text><text>{{language === 'zh' ? '收到答案' : 'Get the answer'}}</text></view>
      </view>
    </block>

    <block wx:elif="{{stage === 'create'}}">
      <view class="eyebrow">♥ {{language === 'zh' ? '别犹豫，勇敢追爱！' : 'A little courage goes a long way'}}</view>
      <view class="title form-title">{{t.creatorTitle}}</view>
      <view class="subtitle">{{t.creatorSub}}</view>
      <label class="field">
        <text class="field-label">{{t.yourName}}</text>
        <input class="field-input" maxlength="30" value="{{creatorName}}" placeholder="{{t.yourPlaceholder}}" bindinput="updateCreator" />
      </label>
      <label class="field">
        <text class="field-label">{{t.theirName}}</text>
        <input class="field-input" maxlength="30" value="{{crushName}}" placeholder="{{t.theirPlaceholder}}" bindinput="updateCrush" />
      </label>
      <label class="field">
        <text class="field-label">{{t.note}}</text>
        <textarea class="field-textarea" maxlength="200" value="{{personalNote}}" placeholder="{{t.notePlaceholder}}" bindinput="updateNote" />
        <text class="counter">{{personalNote.length}} / 200</text>
      </label>
      <view wx:if="{{error}}" class="error">{{error}}</view>
      <button class="primary-button" loading="{{creating}}" disabled="{{creating}}" bindtap="createInvitation"><text>{{creating ? t.creating : t.create}}</text><text wx:if="{{!creating}}" class="button-icon">♥</text></button>
      <button class="back-pill form-back" bindtap="backToCover">‹ {{language === 'zh' ? '返回介绍页' : 'Back to introduction'}}</button>
    </block>

    <block wx:else>
      <view class="ready-heart">✓</view>
      <view class="eyebrow">{{invitation.creatorName}} + {{invitation.crushName}}</view>
      <view class="title form-title">{{t.ready}}</view>
      <view class="subtitle">{{t.readyBody}}</view>
      <view class="ready-actions">
        <button class="primary-button share-button" open-type="share"><text>{{t.share}}</text><text class="button-icon">♥</text></button>
        <view class="share-hint">{{language === 'zh' ? '分享完成后，回来这里等 TA 的答案' : 'Come back here after sharing to wait for their answer.'}}</view>
        <button class="secondary-button result-button" bindtap="openCurrentResult"><text>{{t.result}}</text><text class="button-icon">›</text></button>
        <view class="aux-actions">
          <button class="action-tile" bindtap="openPreview"><text class="action-icon">◉</text><text class="action-title">{{t.preview}}</text><text class="action-note">{{language === 'zh' ? '不会记录答案' : 'No answers saved'}}</text></button>
          <button class="action-tile" bindtap="resetForm"><text class="action-icon">＋</text><text class="action-title">{{t.another}}</text><text class="action-note">{{language === 'zh' ? '创建另一条邀请' : 'Start another invitation'}}</text></button>
        </view>
      </view>
    </block>
  </view>

  <view class="history-card" wx:if="{{invitations.length}}">
    <view class="history-heading"><text>{{t.myInvites}}</text><text>{{t.refresh}}</text></view>
    <view class="history-row" wx:for="{{invitations}}" wx:key="id" data-id="{{item.id}}" bindtap="openResult">
      <view><text class="history-name">{{item.crushName}}</text><text class="history-date">{{item.createdLabel}}</text></view>
      <text class="status {{item.status}}">{{item.statusLabel}}　›</text>
    </view>
  </view>
  <view class="made-with">Made with courage <text class="heart-mark">♥</text></view>
</view>

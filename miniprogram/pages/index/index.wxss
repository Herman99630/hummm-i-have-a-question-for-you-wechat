.creator-card { padding-top: 96rpx; }
.cover-copy { text-align: center; }
.cover-copy .eyebrow { margin-top: 0; }
.cover-title { margin-top: 30rpx; font-size: 68rpx; line-height: 1.12; }
.cover-title text { display: block; }
.cover-title .title-accent { margin-top: 5rpx; color: #a51f4b; }
.cover-bridge { margin: 4rpx 0 22rpx; color: #744351; font-size: 30rpx; font-weight: 750; line-height: 1.55; }
.cover-bridge text { display: block; }
.cover-body { max-width: 580rpx; margin: 0 auto; color: #a27b87; font-size: 24rpx; line-height: 1.75; }
.safe-note { margin-top: 22rpx; color: #9b7782; font-size: 22rpx; text-align: center; }
.cover-image { display: block; width: 76%; max-width: 430rpx; height: 410rpx; margin: 12rpx auto 0; }
.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 10rpx; }
.steps view { padding: 18rpx 8rpx; border-radius: 22rpx; background: #fff4f4; text-align: center; }
.steps text { display: block; color: #865566; font-size: 22rpx; }
.steps text:first-child { margin-bottom: 7rpx; color: #b62752; font-size: 30rpx; font-weight: 800; }
.form-title { font-size: 54rpx; }
.form-back { display: flex; margin: 24rpx auto 0; }
.ready-heart { width: 92rpx; height: 92rpx; margin: 20rpx auto 28rpx; border-radius: 50%; background: #b92754; color: white; font-size: 46rpx; font-weight: 800; line-height: 92rpx; text-align: center; box-shadow: 0 14rpx 32rpx rgba(174, 32, 76, .25); }
.share-button { background: linear-gradient(135deg, #d13562, #94173f); }
.ready-actions { margin-top: 4rpx; }
.share-hint { margin: 18rpx auto 2rpx; color: #a17d88; font-size: 21rpx; line-height: 1.5; text-align: center; }
.result-button { background: #fff8f8; }
.aux-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 22rpx; }
.action-tile { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 146rpx; margin: 0; padding: 18rpx 10rpx; border: 2rpx solid #f1dce2; border-radius: 24rpx; background: #fff7f7; color: #6e3447; line-height: 1.3; }
.action-icon { margin-bottom: 7rpx; color: #b82955; font-size: 31rpx; font-weight: 800; }
.action-title { font-size: 24rpx; font-weight: 750; }
.action-note { margin-top: 6rpx; color: #aa8490; font-size: 19rpx; font-weight: 400; }
.history-card { box-sizing: border-box; width: 100%; max-width: 680px; margin: 28rpx auto 0; padding: 28rpx; border-radius: 32rpx; background: rgba(255,255,255,.82); box-shadow: 0 18rpx 54rpx rgba(101,36,56,.08); }
.history-heading { display: flex; justify-content: space-between; margin-bottom: 10rpx; color: #5a1e31; font-size: 27rpx; font-weight: 800; }
.history-heading text:last-child { color: #ac8792; font-size: 20rpx; font-weight: 500; }
.history-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 2rpx; border-bottom: 2rpx solid #f2e1e5; }
.history-row:last-child { border-bottom: 0; }
.history-name { display: block; font-size: 27rpx; font-weight: 750; }
.history-date { display: block; margin-top: 5rpx; color: #ab8993; font-size: 21rpx; }
.status { padding: 9rpx 15rpx; border-radius: 999rpx; background: #f6e9ec; color: #946675; font-size: 21rpx; }
.status.answered { background: #e7f7ec; color: #397950; }
.status.expired { opacity: .6; }

@media screen and (max-width: 360px) {
  .cover-title { font-size: 60rpx; }
  .cover-bridge { font-size: 27rpx; }
  .cover-image { height: 360rpx; }
  .steps { gap: 8rpx; }
  .steps view { padding-left: 4rpx; padding-right: 4rpx; }
}

.result-card { min-height: 0; padding-top: 70rpx; text-align: center; }
.waiting-image { display: block; width: 70%; max-width: 390rpx; height: 340rpx; margin: 4rpx auto 14rpx; }
.safety-note { margin-top: 24rpx; padding: 18rpx; border-radius: 18rpx; background: #fff4f3; color: #96717d; font-size: 22rpx; line-height: 1.6; }
.refresh-note { margin-top: 22rpx; color: #b08d97; font-size: 21rpx; }
.result-icon { margin-bottom: 20rpx; color: #c6315d; font-size: 90rpx; }
.final-message { margin-top: 32rpx; padding: 26rpx; border-radius: 24rpx; background: linear-gradient(135deg, #ad1d49, #d9436e); color: #fff; font-family: "Yuanti SC", "STYuanti-SC-Bold", "YouYuan", "PingFang SC", sans-serif; font-size: 38rpx; font-weight: 900; box-shadow: 0 16rpx 32rpx rgba(166,30,71,.18); }
.result-card .summary { text-align: left; }
.result-home { display: flex; margin: 28rpx auto 0; }

@media screen and (max-width: 360px) {
  .waiting-image { height: 300rpx; }
}

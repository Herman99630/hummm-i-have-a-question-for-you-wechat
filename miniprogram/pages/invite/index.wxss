.invite-card { min-height: 0; padding-top: 96rpx; }
.invite-shell { padding-bottom: 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.preview-badge { display: table; max-width: 100%; margin: 0 auto 28rpx; padding: 10rpx 18rpx; border-radius: 999rpx; background: #fff0c7; color: #8b6320; font-size: 20rpx; line-height: 1.4; text-align: center; }
.landing, .shock { text-align: center; }
.landing .title { font-size: 62rpx; }
.couple-image { display: block; width: 74%; max-width: 420rpx; height: 390rpx; margin: 18rpx auto 0; }
.personal-note { margin: 24rpx auto 0; padding: 22rpx; border-radius: 22rpx; background: #fff5f5; color: #704151; font-family: "STKaiti", "KaiTi", serif; font-size: 28rpx; line-height: 1.6; }
.personal-note text { display: block; margin-top: 8rpx; color: #a17884; font-family: sans-serif; font-size: 21rpx; }
.answer-yes { margin-left: auto; margin-right: auto; }
.no-zone { box-sizing: border-box; width: 100%; height: 138rpx; padding-top: 24rpx; overflow: hidden; text-align: center; }
.runaway { display: flex; align-items: center; justify-content: center; width: 240rpx; height: 66rpx; margin: 0 auto; padding: 0 18rpx; border: 2rpx dashed #dbb9c2; border-radius: 999rpx; background: rgba(255,255,255,.78); color: #a98691; font-size: 22rpx; line-height: 1.2; text-align: center; transition: transform .15s ease; }
.shock-burst { display: inline-block; margin: 10rpx 0 22rpx; padding: 20rpx 28rpx; border-radius: 50%; background: #b92654; color: #fff; font-size: 38rpx; font-weight: 900; transform: rotate(-7deg); box-shadow: 0 12rpx 28rpx rgba(168,31,73,.22); }
.shock-hearts { margin-bottom: 18rpx; color: #dc416b; font-size: 28rpx; letter-spacing: 8rpx; }
.shock-title { font-size: 56rpx; line-height: 1.22; }
.shock-title text { display: block; }
.shock-copy { margin-top: 22rpx; color: #663246; font-size: 30rpx; font-weight: 700; line-height: 1.65; }
.shock-button { margin-left: auto; margin-right: auto; }
.step-title { margin-top: 20rpx; font-size: 46rpx; }
.picker-card { margin-top: 22rpx; padding: 26rpx; border: 2rpx solid #f0dade; border-radius: 28rpx; background: #fffafa; }
.picker-label { display: block; color: #6d3547; font-size: 25rpx; font-weight: 750; }
.picker-value { margin-top: 20rpx; padding: 24rpx; border-radius: 20rpx; background: #fff0f2; color: #991d45; font-size: 27rpx; font-weight: 800; }
.fatal-heart { margin-bottom: 20rpx; color: #c5315d; font-size: 90rpx; }
.modal-backdrop { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 40rpx 32rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: rgba(76, 17, 39, .55); }
.done-card { box-sizing: border-box; width: 100%; max-width: 560px; max-height: calc(100vh - 80rpx - env(safe-area-inset-bottom)); padding: 52rpx 42rpx; overflow-y: auto; border-radius: 38rpx; background: #fffafa; text-align: center; box-shadow: 0 36rpx 100rpx rgba(58,12,30,.26); }
.done-hearts { color: #d8446d; font-size: 25rpx; }
.done-icon { width: 92rpx; height: 92rpx; margin: 22rpx auto; border-radius: 50%; background: #b72450; color: #fff; font-size: 44rpx; line-height: 92rpx; }
.done-title { margin-bottom: 18rpx; color: #52172a; font-family: "Yuanti SC", "STYuanti-SC-Bold", "YouYuan", "PingFang SC", sans-serif; font-size: 52rpx; font-weight: 900; }
.done-card .primary-button { margin-left: auto; margin-right: auto; }

.lang-en .landing .title { max-width: 570rpx; margin-left: auto; margin-right: auto; font-size: 56rpx; line-height: 1.05; }
.lang-en .personal-note { font-family: "Heart Nunito", "Avenir Next Rounded", sans-serif; font-size: 26rpx; line-height: 1.48; }
.lang-en .personal-note text { font-family: "Heart Nunito", "Avenir Next Rounded", sans-serif; }
.lang-en .shock-title { max-width: 580rpx; margin-left: auto; margin-right: auto; font-size: 51rpx; line-height: 1.08; }
.lang-en .shock-copy { max-width: 560rpx; margin-left: auto; margin-right: auto; font-size: 27rpx; line-height: 1.48; }
.lang-en .step-title { max-width: 580rpx; margin-left: auto; margin-right: auto; font-size: 43rpx; line-height: 1.1; }
.lang-en .picker-label { font-size: 24rpx; }
.lang-en .done-title { font-family: "Heart Nunito", "Avenir Next Rounded", sans-serif; font-size: 48rpx; line-height: 1.08; }

@media screen and (max-width: 360px) {
  .landing .title { font-size: 54rpx; }
  .couple-image { height: 340rpx; }
  .shock-title { font-size: 49rpx; }
  .picker-card { padding: 22rpx; }
  .lang-en .landing .title { font-size: 49rpx; }
  .lang-en .shock-title { font-size: 46rpx; }
  .lang-en .step-title { font-size: 39rpx; }
}
